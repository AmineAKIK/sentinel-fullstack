{
  "name": "sentinel-backend",
  "version": "1.0.0",
  "description": "Sentinel backend API",
  "main": "dist/server.js",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "build": "tsc",
    "typecheck:scripts": "tsc --project tsconfig.scripts.json --noEmit",
    "start": "node dist/server.js",
    "dev": "nodemon --watch src --ext ts --exec ts-node src/server.ts",
    "migrate": "ts-node src/db/migrate.ts",
    "reset:admin": "ts-node src/scripts/reset-admin-password.ts",
    "hash:board": "ts-node src/scripts/hash-board-code.ts",
    "verify:reliability": "node scripts/verifyReliability.js",
    "seed:demo": "node scripts/seedWorkshopProductionDemo.js",
    "seed:e2e": "ts-node scripts/seedE2E.ts",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint src scripts/seedE2E.ts",
    "lint:fix": "eslint src scripts/seedE2E.ts --fix",
    "format:check": "prettier --check src scripts/seedE2E.ts scripts/verifyReliability.js scripts/seedWorkshopProductionDemo.js",
    "format": "prettier --write src scripts/seedE2E.ts scripts/verifyReliability.js scripts/seedWorkshopProductionDemo.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^9.0.1",
    "pg": "^8.11.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.11.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.10.9",
    "@types/pino-http": "^5.8.4",
    "eslint": "^10.5.0",
    "jest": "^30.4.2",
    "nodemon": "^3.0.2",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.4",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.61.0"
  },
  "overrides": {
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "4.2.0"
    }
  }
}
