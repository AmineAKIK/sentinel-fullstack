{
  "name": "sentinel-backend",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "packageManager": "npm@11.16.0",
  "description": "Sentinel backend API",
  "main": "dist/server.js",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc --project tsconfig.build.json",
    "typecheck:scripts": "tsc --project tsconfig.scripts.json --noEmit",
    "start": "node dist/server.js",
    "dev": "nodemon --watch src --ext ts --exec ts-node src/server.ts",
    "migrate": "ts-node src/db/migrate.ts",
    "reset:admin": "ts-node src/scripts/reset-admin-password.ts",
    "hash:board": "ts-node src/scripts/hash-board-code.ts",
    "verify:reliability": "node scripts/verifyReliability.js",
    "seed:demo": "node scripts/seedWorkshopProductionDemo.js",
    "guard:e2e": "ts-node scripts/assertTestDatabase.ts e2e",
    "guard:integration": "ts-node scripts/assertTestDatabase.ts integration",
    "seed:e2e": "ts-node scripts/seedE2E.ts",
    "test": "jest --selectProjects unit",
    "test:integration": "npm run guard:integration && jest --selectProjects integration",
    "test:coverage": "jest --coverage --selectProjects unit",
    "lint": "eslint src scripts/*.ts",
    "lint:fix": "eslint src scripts/*.ts --fix",
    "format:check": "prettier --check src scripts package.json tsconfig.json tsconfig.build.json tsconfig.scripts.json jest.config.ts eslint.config.cjs",
    "format": "prettier --write src scripts package.json tsconfig.json tsconfig.build.json tsconfig.scripts.json jest.config.ts eslint.config.cjs"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^9.0.5",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.21.0",
    "@types/pino-http": "^5.8.4",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.8.1",
    "jest": "^30.4.2",
    "nodemon": "^3.0.2",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.67.0"
  },
  "overrides": {
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "4.3.0"
    },
    "brace-expansion@5": "5.0.8"
  }
}
