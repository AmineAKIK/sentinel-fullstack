# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://sentinel:sentinel_password@localhost:5432/sentinel

# ─── Admin account ────────────────────────────────────────────────────────────
# IMPORTANT: change before first production start — cannot be updated at runtime
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_in_production

# ─── Secrets ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
COOKIE_SECRET=change_me_in_production
JWT_SECRET=change_me_in_production

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Exact URL of the frontend in production (no trailing slash)
CLIENT_ORIGIN=http://localhost:5173

# ─── API rate limiting ────────────────────────────────────────────────────────
GLOBAL_API_RATE_LIMIT_MAX=3000
GLOBAL_API_RATE_LIMIT_WINDOW_MS=900000


# Board display access — SHA-256 of the local display code.
# Generate with: echo -n "votre_code" | sha256sum
BOARD_ACCESS_LABEL=Board atelier
BOARD_SESSION_TTL_HOURS=12
BOARD_ACCESS_CODE_HASH=change_me_sha256_of_board_code

# ─── Email / SMTP (optionnel — notifications dégradées si absent) ──────────────
# Le service mail démarre seulement si SMTP_HOST est défini.
# Exemple avec un relay SMTP local ou un fournisseur (Mailgun, Brevo, Gmail SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Sentinel <noreply@votre-domaine.com>"
# Email de l'administrateur — destinataire des demandes de réinitialisation
ADMIN_EMAIL=
