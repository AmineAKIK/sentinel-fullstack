# Replace the certificate paths and upstream ports with the values used on the host.
server {
    listen 80;
    listen [::]:80;
    server_name sentinel.akiksystems.fr;
    return 301 https://$host$request_uri;
}

server {
    # Syntaxe HTTP/2 compatible avec le Nginx 1.18.0 du serveur hôte.
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name sentinel.akiksystems.fr;
    server_tokens off;

    ssl_certificate /etc/letsencrypt/live/sentinel.akiksystems.fr/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/sentinel.akiksystems.fr/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    client_max_body_size 64k;

    # Une directive add_header définie dans ce serveur empêche l'héritage en
    # bloc des add_header globaux de http{}. La valeur vide n'est jamais émise :
    # cette barrière protège des doublons sans devenir un en-tête public.
    add_header X-Sentinel-Inheritance-Barrier "";

    # Le Nginx hôte est l'unique autorité HSTS publique. Les HSTS des deux
    # upstreams sont masqués dans leurs locations respectives.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    location /api/ {
        # Node reste l'autorité des autres en-têtes de sécurité de /api/*.
        proxy_pass http://127.0.0.1:13000;
        proxy_hide_header Strict-Transport-Security;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }

    location / {
        # Le Nginx frontend reste l'autorité des en-têtes de ses statiques.
        proxy_pass http://127.0.0.1:18080;
        proxy_hide_header Strict-Transport-Security;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }
}
