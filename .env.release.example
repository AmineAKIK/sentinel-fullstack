# Copy to .env on the deployment host and replace every placeholder.
# Never commit the filled .env file.

# Runtime
NODE_ENV=production
PORT=3000
CLIENT_ORIGIN=https://sentinel.example.com

# Database
POSTGRES_DB=sentinel
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=replace_with_a_long_random_database_password
DATABASE_URL=postgres://sentinel:replace_with_a_long_random_database_password@postgres:5432/sentinel

# First admin account
# The seed only creates the account if none exists yet.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_a_long_random_admin_password

# Secrets
# Generate with:
# openssl rand -hex 32
COOKIE_SECRET=replace_with_64_hex_chars
JWT_SECRET=replace_with_64_hex_chars
