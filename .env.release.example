# Copy to .env on the deployment host and replace every placeholder.
# Never commit the filled .env file.

# ─── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
# Niveau de log : trace | debug | info | warn | error | fatal (défaut: info)
LOG_LEVEL=info

# ─── Domaine public (Caddy) ────────────────────────────────────────────────────
# Caddy gère le TLS automatiquement via Let's Encrypt pour ce domaine.
CADDY_DOMAIN=sentinel.example.com

# URL publique vue depuis le navigateur des postes clients.
CLIENT_ORIGIN=https://sentinel.example.com
VITE_API_URL=https://sentinel.example.com

# ─── Proxy inverse ────────────────────────────────────────────────────────────
# Nécessaire pour que le rate limiting utilise la vraie IP client et non celle de Caddy.
TRUST_PROXY=true

# ─── Base de données ──────────────────────────────────────────────────────────
POSTGRES_DB=sentinel
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=replace_with_a_long_random_database_password
DATABASE_URL=postgres://sentinel:replace_with_a_long_random_database_password@postgres:5432/sentinel

# ─── Compte admin ─────────────────────────────────────────────────────────────
# Le seed ne crée le compte que si aucun n'existe encore.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_a_long_random_admin_password

# ─── Secrets ──────────────────────────────────────────────────────────────────
# Générer avec : openssl rand -hex 32
COOKIE_SECRET=replace_with_64_hex_chars
JWT_SECRET=replace_with_64_hex_chars

# ─── Affichage board ──────────────────────────────────────────────────────────
BOARD_ACCESS_LABEL=Board atelier
BOARD_SESSION_TTL_HOURS=12
# SHA-256 du code d'accès board : echo -n "votre_code" | sha256sum
BOARD_ACCESS_CODE_HASH=replace_with_sha256_of_board_code

# ─── Support IA (optionnel) ───────────────────────────────────────────────────
# Si absent, le chat support est désactivé avec un message d'erreur gracieux.
DEEPSEEK_API_KEY=
