# Copy to .env on the deployment host and replace every placeholder.
# Never commit the filled .env file.
#
# Valeurs littérales : Docker Compose interpole les $ NON quotés de ce fichier.
# Toute valeur contenant un $ littéral (bcrypt, certains mots de passe) doit être
# entourée de QUOTES SIMPLES : Compose la traite alors telle quelle et le
# conteneur reçoit exactement la valeur. Les scripts backup/restore lisent ce
# fichier sans l'exécuter, donc espaces, #, apostrophes et guillemets y sont sûrs.

# ─── Runtime ──────────────────────────────────────────────────────────────────
# NODE_ENV=production et PORT=3000 sont fixés par le Compose.
# Niveau de log : trace | debug | info | warn | error | fatal (défaut: info)
LOG_LEVEL=info
# SHA Git complet du commit déployé : git rev-parse HEAD
BUILD_SHA=replace_with_40_character_git_commit_sha

# ─── Domaine public (Caddy) ────────────────────────────────────────────────────
# Caddy gère le TLS automatiquement via Let's Encrypt pour ce domaine.
CADDY_DOMAIN=sentinel.example.com

# Variante Nginx hôte uniquement : ports liés à 127.0.0.1 par l'override.
SENTINEL_BACKEND_BIND_PORT=13000
SENTINEL_FRONTEND_BIND_PORT=18080

# Origine HTTPS publique canonique vue depuis le navigateur : schéma + hôte +
# éventuel port non standard, sans credentials, chemin, query, fragment ni
# slash final. Ne jamais utiliser de wildcard ou de sous-domaine implicite.
CLIENT_ORIGIN=https://sentinel.example.com
# Vide en same-origin : le frontend appelle /api sur son origine publique.
VITE_API_URL=

# ─── Proxy inverse ────────────────────────────────────────────────────────────
# Nécessaire pour que le rate limiting utilise la vraie IP client et non celle de Caddy.
TRUST_PROXY=true

# ─── Limitation API ───────────────────────────────────────────────────────────
# Quota global par IP, hors /api/health. À ajuster selon le nombre de postes
# partageant la même adresse réseau.
GLOBAL_API_RATE_LIMIT_MAX=3000
GLOBAL_API_RATE_LIMIT_WINDOW_MS=900000

# ─── Base de données ──────────────────────────────────────────────────────────
POSTGRES_DB=sentinel
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=replace_with_a_long_random_database_password
DATABASE_URL=postgres://sentinel:replace_with_a_long_random_database_password@postgres:5432/sentinel

# ─── Compte admin ─────────────────────────────────────────────────────────────
# Bootstrap uniquement : requis au premier démarrage sur une base vide.
# Identifiant non vide, 80 caractères maximum et pas uniquement numérique.
# Après création et changement du mot de passe dans l'interface, supprimer ces
# deux variables du fichier de déploiement ; les redémarrages resteront valides.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_a_long_random_admin_password

# ─── Secrets ──────────────────────────────────────────────────────────────────
# Générer avec : openssl rand -hex 32
COOKIE_SECRET=replace_with_64_hex_chars
JWT_SECRET=replace_with_64_hex_chars

# ─── Affichage board ──────────────────────────────────────────────────────────
# Bcrypt du code d'accès board : depuis backend/, BOARD_ACCESS_CODE='votre_code' npm run hash:board
# IMPORTANT : le hash contient des $ ($2b$10$...) que Docker Compose interpolerait
# et tronquerait s'ils étaient nus. L'entourer de QUOTES SIMPLES : Compose prend
# alors la valeur littéralement et le conteneur reçoit le bcrypt exact (60 car.,
# commençant par $2b$, sans quote résiduelle). Reporter la sortie complète telle
# quelle entre quotes simples :
#   hash généré : $2b$10$abcdef...
#   valeur ici  : '$2b$10$abcdef...'
BOARD_ACCESS_CODE_HASH='replace_with_bcrypt_of_board_code_between_single_quotes'

# ─── Support IA (optionnel) ───────────────────────────────────────────────────
# Si absent, le chat support est désactivé avec un message d'erreur gracieux.
DEEPSEEK_API_KEY=
SUPPORT_API_TIMEOUT_MS=20000

# ─── Outbox de notifications ─────────────────────────────────────────────────
NOTIFICATION_BATCH_SIZE=10
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_POLL_INTERVAL_MS=5000

# ─── Email / SMTP (optionnel) ─────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Sentinel <noreply@sentinel.example.com>"
ADMIN_EMAIL=
